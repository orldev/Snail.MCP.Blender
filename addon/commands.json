{
  "note": "What each command means, in one place: which parameters it takes, where among them it names an object or a collection, which of them name a file or a folder, which link carries it, whether it only reads, whether it destroys and whether it reaches beyond Blender. The add-on reads this to refuse a parameter it would otherwise ignore, and for leases, the journal and the Python setting; the server reads the channel to choose the link and its guard tests read the rest for the tool annotations. The params and targets lists are not written by hand: tools/parameters_from_source.py reads them out of the handlers, and CI fails when the file and the handlers disagree.",
  "target_keys": [
    "name",
    "names",
    "target",
    "targets",
    "objects",
    "object",
    "armature",
    "collection",
    "parent",
    "camera",
    "light",
    "strip"
  ],
  "named_after_something_else": [
    "batch_job",
    "snapshot",
    "scenes",
    "view_layer",
    "file_output",
    "render_job",
    "open_project"
  ],
  "channels": {
    "control": "Blender's main thread, one after another: the default, and the only channel that can wait behind a render.",
    "data": "The socket thread, for files and the data directory, so a download never waits behind a render.",
    "monitor": "The socket thread, for a heartbeat and the progress of the render in flight."
  },
