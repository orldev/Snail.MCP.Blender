# Copy to .env beside compose.yml and change what differs on your machine.
# latest follows every release without a suffix; pin both to one release, such as 5.2.1-0.2.0 and 0.2.0, to update
# when you choose.
BLENDER_TAG=latest
MCP_TAG=latest
# OPTIX for RTX cards on Linux, CUDA for older NVIDIA cards and for Docker Desktop on Windows, where OptiX cannot load
# inside a container; NONE for the CPU.
BLENDER_BACKEND=OPTIX
PUBLIC_URL=https://blender.example.com
# The address and port the reverse proxy reaches the server at.
PUBLISH_ADDRESS=192.0.2.10
PUBLISH_PORT=8810
# Allow, Fallback (a script only where no tool covers the job) or Off.
PYTHON_ACCESS=Fallback
