<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Central package management with more than one feed configured requires an explicit mapping (NU1507). Without it a
    public package can shadow a private one of the same name, which is the dependency-confusion attack. Sources
    themselves stay in the user-level configuration; only the routing is pinned here.
  -->
  <packageSources><add key="check" value="/private/tmp/claude-501/-Users-orldev-Projects------------------Toolkit-Snail-Sdk/fdbaaafc-4a25-4325-b964-c4a73b8a65a3/scratchpad/blender/feed" /></packageSources>
  <packageSourceMapping>
    <packageSource key="check"><package pattern="Snail.Sdk" /><package pattern="Snail.Sdk.*" /></packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
