<Project Sdk="Microsoft.NET.Sdk.Razor">

    <Sdk Name="Snail.Sdk.Mcp" />

    <!--
        Framework-dependent, as the Razor pages and the reflection they run on keep it out of Native AOT; stdio for a
        Blender on this machine or behind a tunnel, HTTP beside Blender in the container of deploy/. Snail.Sdk.Mcp sets the
        rest: a dotnet tool of the McpServer kind, Install into ~/.s3l-mcp.
    -->
    <PropertyGroup>
        <SnailMcpNative>false</SnailMcpNative>
        <SnailMcpTransport>Both</SnailMcpTransport>
        <SnailMcpContainer>true</SnailMcpContainer>
        <!-- The tool reference goes where MkDocs reads the site: docs/content/tools and docs/content/schemas. -->
        <SnailReferenceFolder>$(MSBuildProjectDirectory)/../docs/content</SnailReferenceFolder>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.0.0-dev</Version>
        <Description>MCP server that lets AI agents drive a running Blender through its Python add-on: scene, objects, modeling, materials, animation, physics, rendering, video editing and import/export. Runs over stdio for a Blender on this machine or behind an SSH tunnel, or over HTTP with a bearer token beside Blender in Docker.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;blender;3d;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Blender</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Blender</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Jint" />
        <PackageReference Include="ModelContextProtocol" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\addon\**\*" Link="addon\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\docs\theme\css\site.css" LogicalName="assets/site.css" Visible="false" />
        <EmbeddedResource Include="Web\Pages\Assets\pages.css" LogicalName="assets/pages.css" />
        <EmbeddedResource Include="Web\Pages\Assets\pages.js" LogicalName="assets/pages.js" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Blender.Tests" />
    </ItemGroup>

</Project>
